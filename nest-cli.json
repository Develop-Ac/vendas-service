{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "assets/**/*", "outDir": "dist/assets" },
      { "include": "paineis/catalogo/*.json", "watchAssets": true },
      { "include": "paineis/sql/*.sql", "watchAssets": true }
    ]
  }
}
