# ===== vendas-service — variáveis de ambiente (exemplo) =====
# Copie para .env e preencha. NÃO versionar o .env.

# App
PORT=8000
APP_TOKEN=
CORS_ORIGIN=regex:^https?://(localhost:\d+|.*\.acacessorios\.local)$
SWAGGER_ENABLED=false

# PostgreSQL (banco próprio do vendas-service — overlay da carteira)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Portal B2B
PORTAL_B2B_URL=http://localhost:3000
# Token de serviço enviado no header x-servico-token nas chamadas ao portal B2B
AUTH_SECRET=

# ===== SQL Server BI (LEITURA — base de clientes e métricas de venda) =====
# Conta somente-leitura do DW. Usado pela Carteirização (vw_clientes, vw_analise_vendas, d_cadastro_representantes).
BI_SQL_SERVER=192.168.1.146
BI_SQL_DATABASE=BI
BI_SQL_USER=BI_READ_ONLY
BI_SQL_PASSWORD=
BI_SQL_PORT=1433
# Sinônimos aceitos, para ambientes que nomearam a mesma conta de outro jeito:
#   SQL_HOST / SQL_DATABASE / SQL_USER / SQL_PASSWORD / SQL_PORT
#   MSSQL_HOST / MSSQL_DATABASE / MSSQL_USER / MSSQL_PASSWORD / MSSQL_PORT
# Sem nenhum deles o driver conecta com usuário vazio e a Carteirização responde
# lista VAZIA em vez de erro — o serviço agora reclama no boot quando isso ocorre.

# ===== Carteirização — carga diária automática (cron interno) =====
# Reconcilia a carteira com o ERP todo dia. Formato cron (5 campos), fuso America/Sao_Paulo.
# Padrão: 05:00 todos os dias. Ex. de teste: a cada 2 min = "*/2 * * * *".
CARTEIRIZACAO_SYNC_CRON=0 5 * * *
# --- Mais vendidos do atacado (carga semanal para a home do Portal B2B) ---
# Segredo do header `x-servico-token` aceito pelo portal. Sem ele, cai no
# AUTH_SECRET — o portal aceita os dois, mas o dedicado é o recomendado.
SERVICO_TOKEN=
# Critério do ranking: notas | unidades | receita. Padrão: notas (nº de pedidos
# distintos). `unidades` entrega uma vitrine de grampo e parafuso — medido.
MAIS_VENDIDOS_CRITERIO=notas
# Janela de apuração, em meses. Padrão: 12.
MAIS_VENDIDOS_MESES=12
# Quando rodar. Padrão: segunda-feira às 04:00 (America/Sao_Paulo).
MAIS_VENDIDOS_CRON=0 4 * * 1

# ===== erp-firebird-api (LEITURA DIRETA NO ERP — base da Carteirização) =====
# Tira a tela do caminho SQL Server -> OPENQUERY -> Firebird, que pendura sessão
# OLE DB e leva o SQL Server inteiro junto.
ERP_API_URL=http://localhost:8014
ERP_API_TOKEN=
ERP_API_TIMEOUT_MS=120000
# ===== api-vendas-service (GRAVA orçamentos no Celta) =====
# Importação do orçamento fechado: POST /orcamentos/:empresa com x-api-key e
# Idempotency-Key por orçamento. Sem URL/chave a tela avisa que não está configurado.
API_VENDAS_URL=http://localhost:3001
API_VENDAS_KEY=
API_VENDAS_TIMEOUT_MS=30000
# Cron do comparativo intranet x Celta (GET /comparativo/:orcamentoCelta para cada orçamento
# importado e ainda não comparado). Padrão: de 30 em 30 s. "off" desliga.
ORCAMENTO_COMPARATIVO_CRON=*/30 * * * * *
# Fonte da base de clientes da Carteirização: erp (padrão) | bi (volta ao SQL Server).
# Metas, período comissional, equipe do canal e mapa vêm do BI em qualquer caso.
CARTEIRIZACAO_FONTE=erp

# ===== Orçamento do Atacado (precificação v3) =====
# Bolsa de desconto = receita − custo × piso (mês comissional).
# Modo 'dre' (padrão): piso = (CMV + fixas) / (CMV × (1 − variáveis − meta)) com a DRE REAL do canal
# (janela de meses fechados) — sobe se as despesas sobem, cai se o volume cresce; a linha dos 4% é o piso.
# Modo 'degrau': tabela volume→piso pela média dos 3 últimos meses. Modo 'fixo': piso e linha por env.
ORCAMENTO_BOLSA_MODO=dre
ORCAMENTO_BOLSA_DRE_MESES=12
ORCAMENTO_META_RESULTADO=0.04
ORCAMENTO_BOLSA_DEGRAUS=0:1.586,560000:1.538,645000:1.48,700000:1.45,763000:1.421
ORCAMENTO_BOLSA_PISO=1.538
# Linha do prêmio. Vazio ou 0 = o próprio piso (prêmio sobre TODO o saldo retido — decisão 08/09/2026).
ORCAMENTO_LINHA_4PCT=0
# Prêmio = fração do lucro acima da linha; piso do item = custo × 1,25 (abaixo só com aprovação).
ORCAMENTO_PREMIO_PCT=0.25
ORCAMENTO_ITEM_PISO=1.25
# Validade padrão da proposta, em dias.
ORCAMENTO_VALIDADE_DIAS=7
# ICMS na venda para fora do estado. UFs em que o orçamento calcula o imposto (ST para
# contribuinte, DIFAL para não contribuinte/isento em venda não presencial). Só o Pará por
# enquanto: outro estado entra quando o fiscal cadastrar a situação tributária dele no Celta.
ORCAMENTO_TRIBUTACAO_UFS=PA
# Situação tributária do ICMS-ST no Celta (SITUACAO_TRIBUTARIA.ST_CODIGO) — MVA e alíquotas
# são lidas dela a cada orçamento.
ORCAMENTO_ST_SITUACAO=010
# Importação no Celta: mandar regime, DIFAL/ST por item e o DIFAL em Desp. Acessórias (plano v3 da api-vendas-service). Ligar
# só quando a versão da API que aceita esses campos estiver no ar; a atual recusa campo desconhecido.
ORCAMENTO_CELTA_TRIBUTACAO=0
# Liberação de desconto no Celta: chave PRIVADA (PEM Ed25519, entre aspas, quebras como \n) que
# assina o comprovante de aprovação mandado à api-vendas-service na importação. A pública vai na
# API (APROVACAO_CHAVE_PUBLICA). Gere o par com:
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'pem'}));console.log(k.publicKey.export({type:'spki',format:'pem'}))"
ORCAMENTO_APROVACAO_CHAVE_PRIVADA=
# Apuração semanal dos pares "vendem juntos" (12 meses do atacado no BI). Padrão: segunda 04:30.
ORCAMENTO_RELACIONADOS_CRON=30 4 * * 1
ORCAMENTO_RELACIONADOS_MESES=12

# --- avisos-service (avisos-client: catálogo em src/avisos.catalogo.ts) ---
AVISOS_SERVICE_URL=http://avisos-service.acacessorios.local
AVISOS_APP_TOKEN=
AVISOS_DRY_RUN=0

# analytics-atacado-service (opcional): clientes grandes fora do próprio ritmo de compra entram na fila do dia.
# Sem a URL, ou com o serviço fora, a fila sai só pela régua da curva.
ANALYTICS_ATACADO_URL=
ANALYTICS_ATACADO_TOKEN=
ANALYTICS_ATACADO_TIMEOUT_MS=3000
# líquido mínimo em 12 meses para o cliente contar como grande
FILA_CICLO_MINIMO_12M=50000
