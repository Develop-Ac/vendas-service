# ===== vendas-service — variáveis de ambiente (exemplo) =====
# Copie para .env e preencha. NÃO versionar o .env.

# App
PORT=8000
APP_TOKEN=
CORS_ORIGIN=regex:^https?://(localhost:\d+|.*\.acacessorios\.local)$
SWAGGER_ENABLED=false

# PostgreSQL (banco próprio do vendas-service — overlay da carteira)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Portal B2B
PORTAL_B2B_URL=http://localhost:3000

# ===== SQL Server BI (LEITURA — base de clientes e métricas de venda) =====
# Conta somente-leitura do DW. Usado pela Carteirização (vw_clientes, vw_analise_vendas, d_cadastro_representantes).
BI_SQL_SERVER=192.168.1.146
BI_SQL_DATABASE=BI
BI_SQL_USER=BI_READ_ONLY
BI_SQL_PASSWORD=
BI_SQL_PORT=1433