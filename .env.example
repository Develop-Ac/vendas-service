# ===== vendas-service — variáveis de ambiente (exemplo) =====
# Copie para .env e preencha. NÃO versionar o .env.

# App
PORT=8000
APP_TOKEN=
CORS_ORIGIN=regex:^https?://(localhost:\d+|.*\.acacessorios\.local)$
SWAGGER_ENABLED=false

# PostgreSQL (banco próprio do vendas-service — overlay da carteira)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Portal B2B
PORTAL_B2B_URL=http://localhost:3000
# Token de serviço enviado no header x-servico-token nas chamadas ao portal B2B
AUTH_SECRET=

# ===== SQL Server BI (LEITURA — base de clientes e métricas de venda) =====
# Conta somente-leitura do DW. Usado pela Carteirização (vw_clientes, vw_analise_vendas, d_cadastro_representantes).
BI_SQL_SERVER=192.168.1.146
BI_SQL_DATABASE=BI
BI_SQL_USER=BI_READ_ONLY
BI_SQL_PASSWORD=
BI_SQL_PORT=1433

# ===== Carteirização — carga diária automática (cron interno) =====
# Reconcilia a carteira com o ERP todo dia. Formato cron (5 campos), fuso America/Sao_Paulo.
# Padrão: 05:00 todos os dias. Ex. de teste: a cada 2 min = "*/2 * * * *".
CARTEIRIZACAO_SYNC_CRON=0 5 * * *
# --- Mais vendidos do atacado (carga semanal para a home do Portal B2B) ---
# Segredo do header `x-servico-token` aceito pelo portal. Sem ele, cai no
# AUTH_SECRET — o portal aceita os dois, mas o dedicado é o recomendado.
SERVICO_TOKEN=
# Critério do ranking: notas | unidades | receita. Padrão: notas (nº de pedidos
# distintos). `unidades` entrega uma vitrine de grampo e parafuso — medido.
MAIS_VENDIDOS_CRITERIO=notas
# Janela de apuração, em meses. Padrão: 12.
MAIS_VENDIDOS_MESES=12
# Quando rodar. Padrão: segunda-feira às 04:00 (America/Sao_Paulo).
MAIS_VENDIDOS_CRON=0 4 * * 1
