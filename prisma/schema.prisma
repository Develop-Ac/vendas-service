generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
  url      = env("DATABASE_URL")
}

model sis_usuarios {
  nome               String
  senha              String
  trash              Int                @default(0)
  id                 String             @id @default(cuid())
  codigo             String             @unique
  perfil_acesso      String
  avatar_url         String?
  tema_preferencia   String             @default("system")
  setor              String?            @db.VarChar(255)
  vendas_rep_codigo  Int?
  vendas_hub_inicial String?            @db.VarChar(30)
  est_auditoria      est_auditoria[]
  est_contagem       est_contagem[]
  est_contagem_logs  est_contagem_log[]
  fed_comentarios    fed_comentarios[]
  fed_curtidas       fed_curtidas[]
  fed_eventos        fed_eventos[]
  fed_posts          fed_posts[]
  sis_permissoes     sis_permissoes[]
}

model com_cotacao {
  id                String              @id @default(cuid())
  empresa           Int
  pedido_cotacao    Int                 @unique
  indice            Int                 @unique(map: "com_cotacao_indice_unique") @default(autoincrement())
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  dias_compra       Decimal?            @db.Decimal(10, 2)
  com_cotacao_itens com_cotacao_itens[]
}

model com_cotacao_itens {
  pedido_cotacao   Int
  emissao          DateTime?
  pro_codigo       Int
  pro_descricao    String
  mar_descricao    String?
  referencia       String?
  unidade          String?
  quantidade       Int
  dt_ultima_compra DateTime?
  qtd_sugerida     Int?
  com_cotacao      com_cotacao @relation(fields: [pedido_cotacao], references: [pedido_cotacao], onDelete: Cascade)

  @@id([pedido_cotacao, pro_codigo])
}

model ofi_checklists {
  id                           String                   @id @default(cuid())
  osInterna                    String?
  dataHoraEntrada              DateTime?
  observacoes                  String?
  combustivelPercentual        Int?
  clienteNome                  String?
  clienteDoc                   String?
  clienteTel                   String?
  clienteEnd                   String?
  veiculoNome                  String?
  veiculoPlaca                 String?
  veiculoCor                   String?
  veiculoKm                    BigInt?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  assinaturasclienteBase64     String?
  assinaturasresponsavelBase64 String?
  data_hora_entrega            DateTime?                @db.Timestamp(6)
  status                       String?
  assinatura_retirada_base64   String?
  dataHoraEntrega              DateTime?
  assinaturaRetiradaBase64     String?
  clientId                     String?                  @unique
  ofi_checklists_avarias       ofi_checklists_avarias[]
  ofi_checklists_fotos         ofi_checklists_fotos[]
  ofi_checklists_items         ofi_checklists_items[]

  @@index([data_hora_entrega], map: "idx_ofi_checklists_data_hora_entrega")
  @@index([status, data_hora_entrega], map: "idx_ofi_checklists_status_entrega")
}

model ofi_checklists_avarias {
  id             String         @id @default(cuid())
  checklistId    String
  tipo           String?
  peca           String?
  observacoes    String?
  posX           Float?
  posY           Float?
  posZ           Float?
  normX          Float?
  normY          Float?
  normZ          Float?
  fotoBase64     String?
  timestamp      DateTime?
  ofi_checklists ofi_checklists @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model ofi_checklists_items {
  id             String         @id @default(cuid())
  checklistId    String
  item           String
  status         String
  ofi_checklists ofi_checklists @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
}

model com_cotacao_for {
  id             String                  @id @default(cuid())
  empresa        Int                     @default(3)
  pedido_cotacao Int
  for_codigo     Int
  for_nome       String?
  cpf_cnpj       String?
  created_at     DateTime                @default(now())
  updated_at     DateTime                @updatedAt
  trash          Int?                    @default(0)
  itens          com_cotacao_itens_for[]

  @@unique([pedido_cotacao, for_codigo], name: "pedido_for")
  @@index([pedido_cotacao])
}

model com_cotacao_itens_for {
  id             String          @id @default(cuid())
  pedido_cotacao Int
  for_codigo     Int
  emissao        DateTime?
  pro_codigo     Int
  pro_descricao  String
  mar_descricao  String?
  referencia     String?
  unidade        String?
  quantidade     Int
  valor_unitario Float?
  qtd_sugerida   Int?            @default(0)
  ref_fornecedor String?         @db.VarChar(255)
  observacao     String?         @db.VarChar(255)
  ipi            Decimal?        @db.Decimal(10, 2)
  icms           Boolean?
  cotacao        com_cotacao_for @relation(fields: [pedido_cotacao, for_codigo], references: [pedido_cotacao, for_codigo], onDelete: Cascade)

  @@index([pedido_cotacao, for_codigo])
}

model com_pedido {
  id                     String                   @id @default(cuid())
  pedido_cotacao         Int
  for_codigo             Int
  created_at             DateTime                 @default(now())
  updated_at             DateTime                 @updatedAt
  frete                  Decimal?                 @db.Decimal(10, 2)
  prazo                  String?                  @db.VarChar(100)
  nomeFrete              String?                  @db.VarChar(255)
  status                 String?                  @db.VarChar(50)
  categoriaFrete         String?                  @db.VarChar(255)
  data_recebimento       DateTime?
  ipi_no_valor           Boolean                  @default(false)
  status_anterior        String?                  @db.VarChar(50)
  tem_garantia           Boolean                  @default(false)
  garantia_qtd_titulos   Int?
  garantia_qtd_produtos  Int?
  garantia_valor         Decimal?                 @db.Decimal(15, 2)
  garantia_verificada_em DateTime?                @db.Timestamp(6)
  previsao_chegada       DateTime?                @db.Timestamptz(6)
  itens                  com_pedido_itens[]
  com_pedido_nfe_vinculo com_pedido_nfe_vinculo[]

  @@unique([pedido_cotacao, for_codigo])
  @@index([pedido_cotacao])
  @@index([for_codigo])
}

model com_pedido_itens {
  id               String     @id @default(cuid())
  pedido_id        String
  item_id_origem   String?
  pro_codigo       Int
  pro_descricao    String
  mar_descricao    String?
  referencia       String?
  unidade          String?
  emissao          DateTime?
  valor_unitario   Decimal?
  custo_fabrica    Decimal?
  preco_custo      Decimal?
  for_codigo       Int
  quantidade       Decimal
  created_at       DateTime   @default(now())
  renato           Boolean?   @default(false)
  carlos           Boolean?   @default(false)
  justificativa    String?    @db.VarChar(100)
  qtd_sugerida_min Decimal?   @db.Decimal(15, 4)
  qtd_sugerida_max Decimal?   @db.Decimal(15, 4)
  status_item      String?    @db.VarChar(30)
  status_item_por  String?    @db.VarChar(120)
  status_item_em   DateTime?  @db.Timestamp(6)
  quantidade_real  Boolean    @default(false)
  ipi              Decimal?   @db.Decimal(10, 2)
  icms             Boolean?
  pedido           com_pedido @relation(fields: [pedido_id], references: [id], onDelete: Cascade)

  @@unique([pedido_id, pro_codigo, for_codigo])
  @@index([pedido_id])
  @@index([pedido_id, pro_codigo, for_codigo], map: "idx_com_pedido_itens_pedido_produto_sug")
}

model est_contagem {
  id                String             @id @default(cuid())
  colaborador       String
  created_at        DateTime           @default(now())
  contagem          Int                @default(1)
  liberado_contagem Boolean            @default(false)
  contagem_cuid     String?
  piso              String?            @db.VarChar
  status            Int                @default(0)
  tipo              Int                @default(1)
  data_inicio       DateTime?
  data_fim          DateTime?
  usuario           sis_usuarios       @relation(fields: [colaborador], references: [id])
  logs              est_contagem_log[]

  @@index([colaborador])
  @@index([contagem_cuid])
}

model est_contagem_itens {
  id                 String             @id @default(cuid())
  data               DateTime
  cod_produto        Int
  desc_produto       String
  mar_descricao      String?
  ref_fabricante     String?
  ref_fornecedor     String?
  localizacao        String?
  unidade            String?
  qtde_saida         Int
  estoque            Int
  reserva            Int
  conferir           Boolean            @default(true)
  contagem_cuid      String
  aplicacoes         String?
  identificador_item String?            @db.VarChar
  pendente           Boolean            @default(false)
  logs               est_contagem_log[]

  @@index([contagem_cuid])
  @@index([cod_produto])
  @@index([pendente])
}

model est_contagem_log {
  id                 String             @id @default(cuid())
  contagem_id        String
  usuario_id         String
  item_id            String
  estoque            Int
  contado            Int
  created_at         DateTime           @default(now())
  identificador_item String?            @db.VarChar
  contagem           est_contagem       @relation(fields: [contagem_id], references: [id])
  item               est_contagem_itens @relation(fields: [item_id], references: [id])
  usuario            sis_usuarios       @relation(fields: [usuario_id], references: [id])

  @@index([contagem_id])
  @@index([usuario_id])
  @@index([item_id])
}

model com_kanban {
  id        String   @id
  data      Json
  updatedAt DateTime
  createdAt DateTime @default(now())
}

model gar_anexos_garantias {
  id            Int           @id @default(autoincrement())
  garantia_id   Int
  nome_ficheiro String        @db.VarChar(255)
  path_ficheiro String        @db.VarChar(255)
  data_upload   DateTime?     @default(now()) @db.Timestamptz(6)
  gar_garantias gar_garantias @relation(fields: [garantia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model gar_caixa_de_entrada_emails {
  id               Int                @id @default(autoincrement())
  message_id       String             @unique
  garantia_id      Int?
  remetente        String?
  assunto          String?
  corpo_html       String?
  data_recebimento DateTime?          @db.Timestamptz(6)
  foi_processado   Boolean?           @default(false)
  reply_to         String?
  to_list          String[]           @default([])
  cc_list          String[]           @default([])
  bcc_list         String[]           @default([])
  attachments      Json?              @default("[]")
  gar_anexos_email gar_anexos_email[]
  gar_garantias    gar_garantias?     @relation(fields: [garantia_id], references: [id], onUpdate: NoAction)

  @@index([garantia_id], map: "gar_idx_caixa_entrada_garantia_id")
}

model gar_fornecedores_config {
  id                Int     @id @default(autoincrement())
  erp_fornecedor_id Int     @unique
  processo_tipo     String  @db.VarChar(50)
  portal_link       String?
  formulario_path   String?
  nome_formulario   String? @db.VarChar(255)
  instrucoes        String?
}

model gar_garantias {
  id                          Int                           @id @default(autoincrement())
  erp_fornecedor_id           Int?
  nome_fornecedor             String                        @db.VarChar(255)
  email_fornecedor            String?                       @db.VarChar(255)
  produtos                    String
  nota_interna                String                        @db.VarChar(255)
  descricao                   String?
  tipo_garantia               String?                       @db.VarChar(100)
  nfs_compra                  String?                       @db.VarChar(255)
  data_criacao                DateTime?                     @default(now()) @db.Timestamptz(6)
  precisa_nota_fiscal         Boolean?
  cfop                        String?                       @db.VarChar(10)
  frete_por_conta_de          String?                       @db.VarChar(50)
  transportadora_razao_social String?                       @db.VarChar(255)
  transportadora_cnpj         String?                       @db.VarChar(20)
  transportadora_ie           String?                       @db.VarChar(20)
  transportadora_endereco     String?
  numero_nf_devolucao         String?                       @db.VarChar(50)
  data_coleta_envio           DateTime?                     @db.Date
  nf_abatida_boleto           String?                       @db.VarChar(50)
  tipo_credito_final          String?                       @db.VarChar(255)
  protocolo_fornecedor        String?                       @db.VarChar(255)
  tem_nova_interacao          Boolean?                      @default(false)
  copias_email                String?
  transportadora_cidade       String?
  transportadora_uf           String?
  codigo_coleta_envio         String?
  obs                         String?
  valor_credito_total         Decimal?                      @db.Decimal(12, 2)
  valor_credito_utilizado     Decimal                       @default(0) @db.Decimal(12, 2)
  status                      Int                           @default(1)
  gar_anexos_email            gar_anexos_email[]
  gar_anexos_garantias        gar_anexos_garantias[]
  gar_caixa_de_entrada_emails gar_caixa_de_entrada_emails[]
  gar_garantias_abatimentos   gar_garantias_abatimentos[]
  gar_historico_garantias     gar_historico_garantias[]
}

model gar_garantias_abatimentos {
  id            BigInt        @id @default(autoincrement())
  garantia_id   Int
  nf            String
  parcela       String
  vencimento    DateTime      @db.Date
  valor         Decimal       @db.Decimal(12, 2)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  gar_garantias gar_garantias @relation(fields: [garantia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model gar_historico_garantias {
  id              Int           @id @default(autoincrement())
  garantia_id     Int
  descricao       String
  tipo_interacao  String        @db.VarChar(100)
  data_ocorrencia DateTime?     @default(now()) @db.Timestamptz(6)
  foi_visto       Boolean?      @default(true)
  message_id      String?
  assunto         String?
  gar_garantias   gar_garantias @relation(fields: [garantia_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sac_kanban {
  id                 String               @id
  data               DateTime             @db.Timestamptz(6)
  tipo               String?
  custo              String?
  title              String?
  venda              String?
  cliente            String?
  solucao            String?
  vendedor           String?
  createdAt          BigInt
  reclamacao         String?
  dataSolucao        String?
  itemReclamado      String?
  dptoResponsavel    String?
  etapa              String
  updatedAt          DateTime             @db.Timestamptz(6)
  imagem             String?
  devolucao          String?
  notaOuCupomFiscal  String?
  notaDevolucao      String?
  credito            String?
  numeroDacte        String?
  devolutivaSac      String?
  responsavel        String?              @db.VarChar(255)
  telefone           String?              @db.VarChar(20)
  sac_kanban_imagens sac_kanban_imagens[]
  sac_kanban_minion  sac_kanban_minion[]
}

model sis_permissoes {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  usuario_id   String       @db.VarChar(36)
  modulo       String       @db.VarChar
  tela         String       @db.VarChar
  visualizar   Boolean      @default(false)
  editar       Boolean      @default(false)
  criar        Boolean      @default(false)
  deletar      Boolean      @default(false)
  sis_usuarios sis_usuarios @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario")
}

model sac_kanban_imagens {
  id         Int        @id @default(autoincrement())
  kanban_id  String
  imagem     String
  created_at DateTime?  @default(now()) @db.Timestamptz(6)
  storage    String     @default("base64")
  tipo       String     @default("imagem")
  mime_type  String?
  nome       String?
  tamanho    Int?
  bucket     String?
  sac_kanban sac_kanban @relation(fields: [kanban_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([kanban_id], map: "ix_sac_kanban_imagens_kanban")
}

model com_data_saldo_produto {
  id             Int       @id @default(autoincrement())
  pro_codigo     String?   @db.VarChar(50)
  data_compra    DateTime? @db.Date
  saldo_residual Decimal?  @db.Decimal(15, 4)
  created_at     DateTime? @default(now()) @db.Timestamp(6)

  @@index([pro_codigo], map: "idx_saldo_prod_codigo")
}

model com_fifo_completo {
  id                         Int       @id @default(autoincrement())
  data_processamento         DateTime? @default(now()) @db.Timestamp(6)
  pro_codigo                 String?   @db.VarChar(50)
  tempo_medio_estoque        Decimal?  @db.Decimal(15, 4)
  qtd_vendida                Decimal?  @db.Decimal(15, 4)
  valor_vendido              Decimal?  @db.Decimal(15, 4)
  data_min_venda             DateTime? @db.Date
  data_max_venda             DateTime? @db.Date
  periodo_dias               Int?
  demanda_media_dia          Decimal?  @db.Decimal(15, 6)
  num_vendas                 Int?
  vendas_ult_12m             Decimal?  @db.Decimal(15, 4)
  vendas_12m_ant             Decimal?  @db.Decimal(15, 4)
  fator_tendencia            Decimal?  @db.Decimal(10, 6)
  tendencia_label            String?   @db.VarChar(20)
  dias_ruptura               Int?
  demanda_media_dia_ajustada Decimal?  @db.Decimal(15, 6)
  pro_descricao              String?
  estoque_disponivel         Decimal?  @db.Decimal(15, 4)
  mar_descricao              String?   @db.VarChar(100)
  fornecedor1                String?   @db.VarChar(200)
  fornecedor2                String?   @db.VarChar(200)
  fornecedor3                String?   @db.VarChar(200)
  pct_acum_valor             Decimal?  @db.Decimal(10, 4)
  curva_abc                  String?   @db.VarChar(10)
  categoria_estocagem        String?   @db.VarChar(20)
  estoque_min_base           Int?
  estoque_max_base           Int?
  fator_ajuste_tendencia     Decimal?  @db.Decimal(10, 6)
  estoque_min_ajustado       Int?
  estoque_max_ajustado       Int?
  estoque_min_sugerido       Int?
  estoque_max_sugerido       Int?
  tipo_planejamento          String?   @db.VarChar(30)
  alerta_tendencia_alta      String?   @db.VarChar(10)
  descricao_calculo_estoque  String?
  created_at                 DateTime? @default(now()) @db.Timestamp(6)
  sgr_codigo                 Int?
  teve_alteracao_analise     Boolean?  @default(false)
  dados_alteracao_json       String?
  sgr_descricao              String?   @db.VarChar(200)
  group_id                   String?   @db.VarChar(100)
  grp_estoque_disponivel     Decimal?  @db.Decimal(15, 4)
  grp_qtd_vendida            Decimal?  @db.Decimal(15, 4)
  grp_valor_vendido          Decimal?  @db.Decimal(15, 4)
  grp_num_vendas             Int?
  grp_vendas_ult_12m         Decimal?  @db.Decimal(15, 4)
  grp_vendas_12m_ant         Decimal?  @db.Decimal(15, 4)
  grp_estoque_min_base       Int?
  grp_estoque_max_base       Int?
  grp_estoque_min_ajustado   Int?
  grp_estoque_max_ajustado   Int?
  grp_estoque_min_sugerido   Int?
  grp_estoque_max_sugerido   Int?
  grp_demanda_media_dia      Decimal?  @db.Decimal(15, 6)
  rateio_prop_grupo          Decimal?  @db.Decimal(10, 6)
  tempo_medio_saldo_atual    Decimal?  @db.Decimal(15, 2)
  categoria_saldo_atual      String?   @db.VarChar(50)
  pro_referencia             String?
  demanda_real_dia           Decimal?  @db.Decimal(15, 6)
  sigma_demanda_dia          Decimal?  @db.Decimal(15, 6)
  cv_demanda                 Decimal?  @db.Decimal(10, 4)
  classe_xyz                 String?   @db.VarChar(2)
  estoque_seguranca          Int?
  nivel_servico_z            Decimal?  @db.Decimal(6, 4)
  lead_time_dias             Int?
  venda_perdida_12m          Decimal?  @db.Decimal(15, 4)
  valor_vendido_12m          Decimal?  @db.Decimal(15, 4)
  padrao_demanda             String?   @db.VarChar(20)
  metodo_reposicao           String?   @db.VarChar(30)
  fator_sazonal              Decimal?  @db.Decimal(8, 4)
  demanda_planejamento_dia   Decimal?  @db.Decimal(15, 6)
  sob_encomenda              Boolean?  @default(false)
  grupo_chave                String?   @db.VarChar(255)
  grupo_qtd_itens            Int?
  grupo_estoque_disponivel   Decimal?  @db.Decimal(15, 4)
  grupo_demanda_dia          Decimal?  @db.Decimal(15, 6)
  grupo_fator_sazonal        Decimal?  @db.Decimal(8, 4)
  grupo_curva                String?   @db.VarChar(10)
  grupo_padrao               String?   @db.VarChar(20)
  grupo_metodo               String?   @db.VarChar(30)
  grupo_estoque_min          Int?
  grupo_estoque_max          Int?
  grupo_estoque_seguranca    Int?
  mean_size_mes              Decimal?  @db.Decimal(15, 4)
  cv2_tamanho                Decimal?  @db.Decimal(10, 4)
  grupo_mean_size            Decimal?  @db.Decimal(15, 4)
  grupo_cv2                  Decimal?  @db.Decimal(10, 4)
  custo_unitario             Decimal?  @db.Decimal(15, 4)
  margem_unitaria            Decimal?  @db.Decimal(15, 4)
  margem_pct                 Decimal?  @db.Decimal(8, 4)
  nivel_servico_custo        Decimal?  @db.Decimal(6, 4)
  z_custo                    Decimal?  @db.Decimal(6, 4)
  estoque_min_custo          Int?
  estoque_max_custo          Int?
  estoque_seg_custo          Int?
  grupo_nivel_servico_custo  Decimal?  @db.Decimal(6, 4)
  grupo_estoque_min_custo    Int?
  grupo_estoque_max_custo    Int?
  grupo_margem_pct           Decimal?  @db.Decimal(8, 4)
  eh_original                Boolean?  @default(false)
  teve_outlier_aparado       Boolean?  @default(false)
  outlier_qtd_aparada        Decimal?  @db.Decimal(15, 2)
  outlier_motivo             String?   @db.VarChar(255)
  fator_sazonal_ciclo        Decimal?  @db.Decimal(8, 4)
  fornecedor_principal       String?   @db.VarChar(200)
  periodo_revisao_dias       Decimal?  @db.Decimal(6, 2)
  grupo_lead_time_dias       Decimal?  @db.Decimal(6, 2)
  marca_linha                Int?      @db.SmallInt
  preco_venda_1              Decimal?  @db.Decimal(15, 4)
  preco_venda_2              Decimal?  @db.Decimal(15, 4)
  custo_cogs_12m             Decimal?  @db.Decimal(15, 4)
  custo_fonte                String?   @db.VarChar(20)
  margem_unitaria_realizada  Decimal?  @db.Decimal(15, 4)

  @@index([teve_alteracao_analise], map: "idx_com_fifo_alteracao")
  @@index([categoria_estocagem], map: "idx_com_fifo_categoria_estocagem")
