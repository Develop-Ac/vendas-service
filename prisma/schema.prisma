// CRM do Atacado (fase 1) — fila do dia gerada pela régua por curva. A tarefa
// fecha SOZINHA por sinal observado (orçamento/venda do cliente após gerada_em);
// prazo estourado sem sinal vira ESCALADA (visível ao supervisor). O unique
// parcial "1 tarefa em andamento por cliente" mora no SQL manual
// (uq_ven_fila_tarefa_andamento) — o Prisma não expressa índice parcial.
model ven_fila_tarefa {
  id              String    @id @default(cuid())
  tipo            String // CONTATO | RESGATE
  cli_codigo      Int
  cli_nome        String?
  rep_codigo      Int?
  rep_nome        String?
  curva           String?
  motivo_geracao  String?
  gerada_em       DateTime  @default(now()) @db.Timestamptz(6)
  prazo_em        DateTime  @db.Timestamptz(6)
  status          String    @default("ABERTA") // ABERTA | ESCALADA | CONCLUIDA | CANCELADA
  escalada_em     DateTime? @db.Timestamptz(6)
  concluida_em    DateTime? @db.Timestamptz(6)
  conclusao_sinal String? // VENDA | ORCAMENTO | (futuro) MENSAGEM
  conclusao_obs   String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([rep_codigo, status], map: "idx_ven_fila_tarefa_rep_status")
  @@index([status, prazo_em], map: "idx_ven_fila_tarefa_status_prazo")
  @@index([cli_codigo], map: "idx_ven_fila_tarefa_cli")
  @@index([gerada_em], map: "idx_ven_fila_tarefa_gerada")
}

// Desfecho do orçamento que não fechou — a única digitação nova do vendedor
// (1 toque, 6 motivos). É a pesquisa de motivo de perda da fase 1.
model ven_orcamento_desfecho {
  id           String   @id @default(cuid())
  empresa      Int      @default(3)
  orcamento    Int
  emissao      DateTime? @db.Date
  cli_codigo   Int
  cli_nome     String?
  rep_codigo   Int?
  rep_nome     String?
  total        Decimal  @default(0) @db.Decimal(15, 2)
  motivo       String // PRECO | PRAZO_FRETE | SEM_ESTOQUE | CONCORRENTE | CLIENTE_ADIOU | CREDITO_BLOQUEADO
  observacao   String?
  usuario_id   String?
  usuario_nome String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([empresa, orcamento], map: "uq_ven_orc_desfecho_orcamento")
  @@index([cli_codigo], map: "idx_ven_orc_desfecho_cli")
  @@index([rep_codigo], map: "idx_ven_orc_desfecho_rep")
  @@index([motivo], map: "idx_ven_orc_desfecho_motivo")
  @@index([created_at], map: "idx_ven_orc_desfecho_created")
}

// Sensor WhatsApp (piloto WAHA) — vínculo telefone -> cliente. Casamento pela
// chave DDD + últimos 8 dígitos (sobrevive ao 9º dígito). N números -> 1 cliente.
model ven_wa_contato {
  id         String   @id @default(cuid())
  chave      String   @unique(map: "uq_ven_wa_contato_chave")
  telefone   String
  cli_codigo Int
  cli_nome   String?
  origem     String   @default("SEED_ERP") // SEED_ERP | MANUAL
  criado_por String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([cli_codigo], map: "idx_ven_wa_contato_cli")
}

// Sensor WhatsApp — SÓ METADADOS (decisão do plano: nenhum corpo de mensagem).
// Uma linha por evento de mensagem, deduplicada por (sessao, message_id).
model ven_wa_mensagem {
  id            String   @id @default(cuid())
  message_id    String
  sessao        String // sessão WAHA (convenção: rep-<codigo>)
  rep_codigo    Int?
  chat_telefone String
  chave         String
  cli_codigo    Int? // resolvido via ven_wa_contato; NULL = fila de vínculo
  direcao       String // ENVIADA | RECEBIDA
  tipo          String?
  timestamp     DateTime @db.Timestamptz(6)
  ack           Int?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([sessao, message_id], map: "uq_ven_wa_msg_sessao_id")
  @@index([cli_codigo, direcao, timestamp], map: "idx_ven_wa_msg_cli_dir_ts")
  @@index([chave], map: "idx_ven_wa_msg_chave")
  @@index([sessao, timestamp], map: "idx_ven_wa_msg_sessao_ts")
}
